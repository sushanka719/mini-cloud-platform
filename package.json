{
  "name": "forgecloud",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.4",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "build:packages": "pnpm --filter \"./packages/**\" build",
    "build": "pnpm build:packages && pnpm --filter \"./apps/**\" build",
    "dev": "pnpm build:packages && concurrently -k -n packages,api,worker,dashboard -c gray,cyan,yellow,magenta \"pnpm --filter \\\"./packages/**\\\" --parallel dev\" \"pnpm --filter @forge/api dev\" \"pnpm --filter @forge/worker dev\" \"pnpm --filter @forge/dashboard dev\"",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "pnpm -r test",
    "cluster": "node scripts/cluster.mjs",
    "infra:up": "docker compose -f infra/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/docker-compose.yml down",
    "infra:logs": "docker compose -f infra/docker-compose.yml logs -f",
    "migrate": "pnpm --filter @forge/db migrate"
  },
  "devDependencies": {
    "@eslint/js": "^9.37.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.37.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "argon2",
      "esbuild"
    ]
  }
}
