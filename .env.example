# ---------------------------------------------------------------------------
# ForgeCloud environment. Copy to .env and adjust. Never commit the real .env.
# ---------------------------------------------------------------------------

# 'development' | 'test' | 'production'
NODE_ENV=development

# pino log level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=debug

# --- API -------------------------------------------------------------------
# Host/port the Fastify API binds to.
API_HOST=0.0.0.0
API_PORT=4000
# Comma-separated origins allowed by CORS (the dashboard). Also the allowlist
# the WebSocket handshake is checked against — a WS upgrade is NOT subject to
# CORS, so this is what stops another site opening a socket with the user's
# session cookie.
CORS_ORIGIN=http://localhost:3000
# Names this API process in WebSocket `hello` frames so the dashboard can show
# which replica served a socket. Defaults to "<hostname>-<pid>".
# API_INSTANCE_ID=api-1
# Max time (ms) graceful shutdown waits for in-flight work before forcing exit.
SHUTDOWN_TIMEOUT_MS=10000

# --- Postgres --------------------------------------------------------------
# Host ports are 5433/6380 because 5432/6379 are commonly taken by local installs.
DATABASE_URL=postgres://forge:forge@localhost:5433/forgecloud
# Pool size per process.
DATABASE_POOL_MAX=10

# --- Redis -----------------------------------------------------------------
REDIS_URL=redis://localhost:6380

# --- Dashboard (Next.js, must be NEXT_PUBLIC_ to reach the browser) --------
NEXT_PUBLIC_API_URL=http://localhost:4000

# --- Auth ------------------------------------------------------------------
# Opaque session lifetime in seconds (default 7 days). Cookie + Redis key share it.
SESSION_TTL_SECONDS=604800
# Name of the session cookie issued to the dashboard.
SESSION_COOKIE_NAME=forge_session
# 'true' only when serving over HTTPS; local dev is plain http.
SESSION_COOKIE_SECURE=false

# --- Secrets ---------------------------------------------------------------
# AES-256-GCM key for project env vars at rest. MUST be 32 bytes, base64.
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=REPLACE_ME_openssl_rand_base64_32

# --- Local object storage --------------------------------------------------
# Relative paths are resolved against the repo root, so every process agrees.
STORAGE_ROOT=./storage
# Max size of a single uploaded source archive, in bytes (50 MiB).
MAX_UPLOAD_BYTES=52428800
# gzip level for artifacts: 1 = fastest, 9 = smallest, 6 = zlib default.
GZIP_LEVEL=6
# Threads in the compression worker pool (worker_threads, spawned lazily).
COMPRESSION_THREADS=2

# --- Queue & worker --------------------------------------------------------
# Display name for the worker in the registry; defaults to "<hostname>-<pid>".
# WORKER_NAME=worker-1
# Deployments a single worker process runs concurrently.
WORKER_CONCURRENCY=2
# Heartbeat interval (ms). The Redis heartbeat key TTL is 3x this.
WORKER_HEARTBEAT_MS=5000
# BullMQ attempts per *retryable* deployment failure (health-check timeout,
# build killed by a signal, project lock held too long). A failure the pipeline
# knows is not retryable (a build that exited non-zero) skips the retries and
# goes straight to the dead-letter queue.
DEPLOY_JOB_ATTEMPTS=3
# Base delay (ms) for exponential backoff between attempts: 5s, 10s, 20s…
DEPLOY_JOB_BACKOFF_MS=5000
# How many exhausted jobs `deployments-dlq` keeps for inspection.
DEPLOY_DLQ_KEEP=1000
# How long a job may go without renewing its lock before it is called stalled.
# This is the clock the Phase 10 crash demo runs on: kill a worker mid-build and
# nothing can happen until its lock lapses.
DEPLOY_JOB_LOCK_MS=30000
# How often each worker scans for jobs whose lock has lapsed. Recovery therefore
# takes up to DEPLOY_JOB_LOCK_MS + this.
DEPLOY_JOB_STALL_INTERVAL_MS=15000
# How many times one job may be recovered from a stall before BullMQ fails it
# outright. A stall burns no retry attempt, so this is a separate ceiling — it
# stops a job that reliably kills its worker from killing the whole fleet.
DEPLOY_JOB_MAX_STALLED=2
# Deadline (ms) for one producer-side queue command; turns a dead Redis into a
# 503 rather than a hung request.
QUEUE_OPERATION_TIMEOUT_MS=5000

# --- Build execution -------------------------------------------------------
# Root of the per-deployment build sandboxes. Relative paths are resolved
# against the repo root, like STORAGE_ROOT. Every path a build touches is
# checked to be inside its own sandbox.
BUILD_ROOT=./builds
# Deadlines (ms) per step. Exceeding one kills the whole process group.
BUILD_INSTALL_TIMEOUT_MS=300000
BUILD_BUILD_TIMEOUT_MS=300000
# Grace period (ms) between SIGTERM and SIGKILL when a step has to be killed.
BUILD_KILL_GRACE_MS=5000
# Build output persisted per deployment (4 MiB). Past this the log is
# truncated with a notice.
BUILD_MAX_LOG_BYTES=4194304
# Cap on streamed/replayable log rows in deployment_events. The complete log
# always goes to the stored log object.
BUILD_MAX_LOG_EVENTS=5000
# Extraction guards against a hostile archive (512 MiB / 50k files).
BUILD_MAX_EXTRACT_BYTES=536870912
BUILD_MAX_EXTRACT_FILES=50000
# Keep the sandbox after a deployment finishes, to inspect what it produced.
BUILD_KEEP_SANDBOX=false
# PATH given to build processes. The worker's own environment is NOT inherited
# (it holds DATABASE_URL, REDIS_URL, ENCRYPTION_KEY), so PATH is passed
# explicitly. Leave unset to reuse the worker's PATH.
# BUILD_PATH=/usr/local/bin:/usr/bin:/bin

# --- Docker deployment -----------------------------------------------------
# Docker Engine socket. Set DOCKER_HOST instead to reach a remote daemon.
DOCKER_SOCKET=/var/run/docker.sock
# Runtime base image every deployment is built FROM.
DOCKER_BASE_IMAGE=node:22-alpine
# Pull the base image if it is missing locally. Off so an offline demo fails
# with a clear message instead of hanging on a registry.
DOCKER_PULL_BASE_IMAGE=false
# First path component of the images we build: forge/<slug>-<id>:<tag>.
DOCKER_IMAGE_PREFIX=forge
# Network deployment containers join; created on demand as a user-defined
# bridge. "host" is refused — no host networking (CLAUDE.md §8).
DOCKER_NETWORK=forge-deployments
# Host interface published ports bind to. Loopback = reachable from this
# machine only.
DOCKER_HOST_IP=127.0.0.1
# Per-container resource limits.
DOCKER_MEMORY_MB=512
DOCKER_CPUS=1
DOCKER_PIDS_LIMIT=256
# Read-only root filesystem with a tmpfs at /tmp.
DOCKER_READONLY_ROOTFS=true
DOCKER_TMPFS_MB=64
# Deadlines (ms) for the image build and for create+start.
DOCKER_BUILD_TIMEOUT_MS=300000
DOCKER_START_TIMEOUT_MS=60000
# Health-check polling interval and per-attempt HTTP timeout (ms). The total
# budget is the project's own healthTimeoutMs.
DOCKER_HEALTH_INTERVAL_MS=1000
DOCKER_HEALTH_REQUEST_TIMEOUT_MS=3000
# Grace period (s) Docker gives a container between SIGTERM and SIGKILL.
DOCKER_STOP_GRACE_SECONDS=10
# Container startup lines followed into the deployment's log.
DOCKER_MAX_RUNTIME_LOG_LINES=2000
# Container stats sampling; 0 disables the monitor.
DOCKER_STATS_INTERVAL_MS=3000
DOCKER_STATS_TTL_SECONDS=20
# Cap on the build context / artifact tarball (512 MiB).
DOCKER_MAX_CONTEXT_BYTES=536870912
# Store the build context as a gzip artifact object per deployment.
DOCKER_STORE_ARTIFACT=true
# Images kept per project; a rollback can only reach back this far.
DOCKER_KEEP_IMAGES=5
# Waiting for lock:project:<id> before giving up, and that lock's TTL (ms).
DOCKER_LOCK_WAIT_MS=30000
DOCKER_LOCK_TTL_MS=60000

# --- Observability (Phase 9) --------------------------------------------------
# How often every process samples itself, writes its metrics document to Redis
# and publishes on the `metrics` WS topic. 0 disables the reporter.
METRICS_INTERVAL_MS=2000
# How long a process's metrics document stays readable (s). A killed process
# drops off the dashboard when its key expires.
METRICS_TTL_SECONDS=15
# Default trailing window for the deployment aggregates (minutes).
METRICS_WINDOW_MINUTES=60
# Bearer token for GET /metrics, so a Prometheus scraper (which carries no
# session cookie) can read it. Without it, /metrics needs a logged-in user.
# Generate: openssl rand -hex 24
# METRICS_TOKEN=
# Request-latency samples each API process keeps for its percentiles.
METRICS_LATENCY_SAMPLES=512

# --- Local scaling (Phase 10) -------------------------------------------------
# The hand-written reverse proxy that puts one address in front of N API
# replicas. `pnpm cluster` starts it and sets PROXY_UPSTREAMS for you.
PROXY_HOST=0.0.0.0
PROXY_PORT=4100
# API replicas to balance across, as host:port. Empty means "just API_PORT", so
# the proxy can front an unmodified single-process setup unchanged.
# PROXY_UPSTREAMS=127.0.0.1:4001,127.0.0.1:4002
# Path the proxy polls to decide a replica is usable. Liveness, not readiness:
# a replica whose Postgres is down stays in rotation and answers a truthful 503
# rather than being routed around silently.
PROXY_HEALTH_PATH=/health/live
PROXY_HEALTH_INTERVAL_MS=2000
PROXY_HEALTH_TIMEOUT_MS=1500
# Consecutive probe results needed to flip a replica's state. Asymmetric on
# purpose: drop one fast, take it back slowly.
PROXY_UNHEALTHY_AFTER=2
PROXY_HEALTHY_AFTER=2
# How long the proxy waits for an upstream's response *headers*. Generous — a
# source upload streams through it. A response already streaming is never cut.
PROXY_UPSTREAM_TIMEOUT_MS=120000
# Idle timeout on a proxied connection. Must exceed the WebSocket ping interval
# or live sockets would be culled between frames.
PROXY_IDLE_TIMEOUT_MS=120000

# How far back the fleet view looks for workers. A `workers` row per process run
# is the right history; as a live view it would otherwise list every process
# that ever ran on this laptop.
FLEET_WORKER_WINDOW_MINUTES=120
# A deployment stuck in an in-flight status with no live worker behind it is
# recorded as failed (WORKER_LOST) after this long. Well clear of the stall
# window above, because BullMQ's own recovery is the good path — this only
# catches deployments whose job the queue lost entirely.
ORPHAN_REAP_AFTER_MS=180000
# How often a worker runs that sweep. 0 disables it.
ORPHAN_REAP_INTERVAL_MS=30000
